# STT議事録システム .gitignore

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# pipenv
Pipfile.lock

# poetry
poetry.lock

# pdm
.pdm.toml

# PEP 582
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# =============================================================================
# STT システム固有
# =============================================================================

# 設定ファイル (実際の値を含む)
settings.json
config.json
.env

# ログファイル
logs/
*.log
stt_system.log

# 一時ファイル
temp/
tmp/
*.tmp
*.temp

# 音声・動画ファイル (テスト用以外)
*.mp3
*.mp4
*.wav
*.m4a
*.avi
*.mov
*.mkv
*.flv
*.webm
*.ogg
*.aac
*.wma
*.flac

# ただし、テスト用の小さなサンプルファイルは除外しない
!src/tests/fixtures/*.mp3
!src/tests/fixtures/*.wav
!examples/sample_files/*.mp3
!examples/sample_files/*.wav

# 出力ファイル
output/
results/
generated/
*.md.output
*.txt.output

# 分割された音声ファイル
*_chunk_*.wav
*_chunk_*.mp3
*_split_*.wav
*_split_*.mp3

# 変換された音声ファイル
*_converted.*
*_processed.*

# =============================================================================
# IDE・エディタ
# =============================================================================

# Visual Studio Code
.vscode/
!.vscode/settings.json.example
!.vscode/launch.json.example

# PyCharm
.idea/
*.iws
*.iml
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# =============================================================================
# OS固有
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# =============================================================================
# 開発・ビルドツール
# =============================================================================

# Node.js (ドキュメント生成等で使用する場合)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker
.dockerignore

# =============================================================================
# セキュリティ・機密情報
# =============================================================================

# API キー・トークン
*.key
*.pem
*.p12
*.pfx
secrets/
credentials/

# データベース
*.db
*.sqlite
*.sqlite3

# =============================================================================
# パフォーマンス・プロファイリング
# =============================================================================

# プロファイリング結果
*.prof
*.profile
profile_results/

# ベンチマーク結果
benchmark_results/
performance_logs/

# =============================================================================
# バックアップ・アーカイブ
# =============================================================================

# バックアップファイル
*.bak
*.backup
*.old
*.orig

# アーカイブファイル
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz
*.7z
*.rar

# ただし、リリース用アーカイブは除外しない
!releases/*.zip
!releases/*.tar.gz
