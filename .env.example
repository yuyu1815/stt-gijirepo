# STT議事録システム - 環境変数設定テンプレート
# このファイルを .env にコピーして実際の値を設定してください

# =============================================================================
# API設定
# =============================================================================

# Gemini API設定（必須）
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Notion API設定（Notion連携を使用する場合）
NOTION_TOKEN=your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here

# =============================================================================
# 処理設定
# =============================================================================

# 音声処理設定
MAX_AUDIO_DURATION=2400  # 最大音声長（秒）デフォルト: 40分
CHUNK_SIZE=600           # チャンク分割サイズ（秒）デフォルト: 10分
MAX_RETRIES=5            # API呼び出し最大リトライ回数
RETRY_DELAY=2.0          # リトライ間隔（秒）

# 品質設定
MIN_CONFIDENCE_THRESHOLD=0.7    # 最小信頼度閾値
ENABLE_QUALITY_CHECK=true       # 品質チェック有効化
ENABLE_HALLUCINATION_CHECK=true # ハルシネーション検出有効化

# =============================================================================
# 出力設定
# =============================================================================

# 出力形式設定
OUTPUT_FORMAT=markdown          # 出力形式: markdown, text, json
INCLUDE_TIMESTAMPS=true         # タイムスタンプ含有
INCLUDE_SPEAKER_LABELS=false    # 話者ラベル含有

# ファイル出力設定
OUTPUT_DIR=./output            # 出力ディレクトリ
TEMP_DIR=./temp               # 一時ファイルディレクトリ

# =============================================================================
# ログ設定
# =============================================================================

# ログレベル設定
LOG_LEVEL=INFO                 # ログレベル: DEBUG, INFO, WARNING, ERROR
LOG_DIR=./logs                # ログディレクトリ
ENABLE_CONSOLE_LOG=true       # コンソールログ有効化
ENABLE_FILE_LOG=true          # ファイルログ有効化

# =============================================================================
# パフォーマンス設定
# =============================================================================

# 並列処理設定
MAX_CONCURRENT_FILES=3        # バッチ処理時の最大並列ファイル数
MAX_CONCURRENT_CHUNKS=5       # 音声分割時の最大並列チャンク数

# メモリ管理設定
MAX_MEMORY_USAGE=80          # 最大メモリ使用率（%）
CLEANUP_TEMP_FILES=true      # 一時ファイル自動削除

# =============================================================================
# 開発・デバッグ設定
# =============================================================================

# デバッグ設定
DEBUG_MODE=false             # デバッグモード
VERBOSE_LOGGING=false        # 詳細ログ出力
SAVE_INTERMEDIATE_FILES=false # 中間ファイル保存

# テスト設定
TEST_MODE=false              # テストモード
MOCK_API_CALLS=false         # API呼び出しモック化

# =============================================================================
# セキュリティ設定
# =============================================================================

# ファイルアクセス制限
ALLOWED_FILE_EXTENSIONS=.mp3,.wav,.mp4,.avi,.mov,.mkv,.m4a,.aac,.flac,.ogg,.wma,.wmv,.flv,.webm,.m4v
MAX_FILE_SIZE=1073741824     # 最大ファイルサイズ（バイト）デフォルト: 1GB
SCAN_UPLOADED_FILES=true     # アップロードファイルスキャン

# API制限
API_RATE_LIMIT=60           # API呼び出し制限（回/分）
API_TIMEOUT=300             # APIタイムアウト（秒）

# =============================================================================
# クラス情報設定（既存機能との互換性）
# =============================================================================

# クラス情報抽出設定
ENABLE_CLASS_INFO_EXTRACTION=true  # クラス情報抽出有効化
CLASS_INFO_SOURCE=filename         # クラス情報ソース: filename, metadata, prompt
DEFAULT_CLASS_NAME=不明             # デフォルトクラス名
DEFAULT_TEACHER_NAME=不明           # デフォルト教師名

# =============================================================================
# 高度な設定
# =============================================================================

# LangGraph設定
LANGGRAPH_CHECKPOINT_BACKEND=memory  # チェックポイントバックエンド
LANGGRAPH_THREAD_POOL_SIZE=4         # スレッドプールサイズ

# 監視・メトリクス設定
ENABLE_PERFORMANCE_MONITORING=true   # パフォーマンス監視有効化
METRICS_COLLECTION_INTERVAL=60       # メトリクス収集間隔（秒）
ENABLE_HEALTH_CHECK=true             # ヘルスチェック有効化

# =============================================================================
# 使用例
# =============================================================================

# 基本的な使用例:
# 1. このファイルを .env にコピー
# 2. GEMINI_API_KEY に実際のAPIキーを設定
# 3. 必要に応じて他の設定を調整
# 4. python src/main.py your_audio_file.mp3

# Notion連携を使用する場合:
# 1. NOTION_TOKEN と NOTION_DATABASE_ID を設定
# 2. python src/main.py your_audio_file.mp3 --upload-notion

# バッチ処理の場合:
# 1. MAX_CONCURRENT_FILES を調整
# 2. python src/main.py /path/to/audio/folder --batch